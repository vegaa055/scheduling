# Copy to .env and adjust. Defaults match infra/docker-compose.yml.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://sched:sched@localhost:5544/sched
REDIS_URL=redis://localhost:6380
SOLVER_URL=http://localhost:8095
SESSION_SECRET=dev-only-session-secret-change-me-0123456789

# dev | saml | header
AUTH_MODE=dev

# SAML (AUTH_MODE=saml). With the docker-compose SimpleSAMLphp IdP:
SAML_SP_ENTITY_ID=http://localhost:3000/api/auth/saml/metadata
SAML_ACS_URL=http://localhost:3000/api/auth/saml/acs
SAML_IDP_METADATA_URL=http://localhost:8085/simplesaml/saml2/idp/metadata.php
# For the campus Shibboleth IdP, use its metadata URL or set these two instead:
# SAML_IDP_SSO_URL=https://shibboleth.example.edu/idp/profile/SAML2/Redirect/SSO
# SAML_IDP_CERT=MIIDXTCCAkWgAwIBAgIJ...
SAML_ADMIN_GROUPS=sched-admins
SAML_SCHEDULER_GROUPS=sched-schedulers
